                      CF21 = 3.636864933591221e-06 	# Coeff 21 of forward polynomial 1
                      CF22 = 0.67615794091691761 	# Coeff 1 of forward polynomial 2
                      CF23 = 0.11132088401791965 	# Coeff 2 of forward polynomial 2
