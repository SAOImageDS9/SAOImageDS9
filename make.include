#-------------------------- tclasdf

# Tcl commands used by ds9/library/asdf.tcl - among them asdflz4decompress
# and asdfbz2decompress, which decompress lz4 and bzp2 ASDF blocks (see
# TODO.md Phases 2 and 5; real Roman files use lz4). A
# standalone Tcl extension (like vector/fitsy) so the logic lives once,
# instead of being hand-duplicated across the unix/macos/win copies of
# ds9/*/ds9.C - lz4 and bzip2 are passed in explicitly here (CPPFLAGS/
# LDFLAGS/LIBS), the same convention already used for e.g. ast's CPPFLAGS or
# tls's --with-openssl-dir, since no TEA macro finds a vendored library on
# its own.
# no config.cache - the shared cache file doesn't know about the extra
# CPPFLAGS/LDFLAGS/LIBS below and refuses a stale run rather than risk
# silently reusing a different environment's results.

tclasdf	: tclasdf/Makefile
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C tclasdf -j $(JOBS) install

tclasdf/Makefile :
	@echo ""
	@echo "*** $@ ***"
	cd tclasdf; \
	./configure \
	$(WITHTCL) \
	$(PREFIX) \
	$(STD) \
	CPPFLAGS='-I$(includedir)' \
	LDFLAGS='-L$(libdir)' \
	LIBS='-llz4 -lbz2'

#-------------------------- libyaml

# no config.cache
#
# $(CACHE) and $(CONFIGFLAGS)/$(TARGET) are mutually exclusive, and every
# other package in this file obeys that: the cross-flagged ones (xpa,
# funtools, ast) all omit $(CACHE), and the ones that use $(CACHE)
# (vector, fitsy, tkblt, ...) inherit the toolchain via --with-tcl/--with-tk
# instead of naming it. The shared $(prefix)/config.cache is written by
# those latter runs, which never set build_alias/host_alias/target_alias or
# CC, so a configure that *does* set them then aborts on load with
# "`build_alias' was not set in the previous run ... changes in the
# environment can compromise the build". libyaml had both and broke the
# win/ cross build exactly that way - and, worse, had it succeeded first it
# would have written those variables into the shared cache and broken every
# $(CACHE)-using package with the mirror-image error.
libyaml	: libyaml/Makefile
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C libyaml -j $(JOBS) install

libyaml/Makefile :
	@echo ""
	@echo "*** $@ ***"
	cd libyaml; \
	./configure \
	--disable-shared --enable-static \
	$(CONFIGFLAGS) $(TARGET) \
	$(PREFIX)

#-------------------------- ast

ast	: ast/Makefile ast/ast.h ast/.libs/libast.a ast/.libs/libast_err.a ast/.libs/libast_pal.a ast/.libs/libast_cminpack.a

ast/Makefile :
	@echo ""
	@echo "*** $@ ***"
	cd ast; \
	./configure \
	$(ASTFLAGS) \
	CPPFLAGS='-std=gnu99 -w' \
	--without-pthreads --enable-shared=no \
	--with-yaml=$(prefix) \
	star_cv_cnf_trail_type=long star_cv_cnf_f2c_compatible=no \
	$(CONFIGFLAGS) \
	$(PREFIX)
	cd ast; touch configure.ac aclocal.m4 configure Makefile.am Makefile.in config.h.in

ast/ast.h :
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C ast -j ast.h
	$(MAKE) -C ast -j $(JOBS) libast.la
	$(MAKE) -C ast -j $(JOBS) libast_err.la
	$(MAKE) -C ast -j $(JOBS) libast_pal.la
	$(MAKE) -C ast -j $(JOBS) libast_cminpack.la
	cp ast/ast.h $(includedir)/.
	cp ast/src/grf.h $(includedir)/.
	cp ast/src/grf3d.h $(includedir)/.
	cp ast/.libs/libast.a $(libdir)/.
	cp ast/.libs/libast_err.a $(libdir)/.
	cp ast/.libs/libast_pal.a $(libdir)/.
	cp ast/.libs/libast_cminpack.a $(libdir)/.

ast/.libs/libast.a :
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C ast -j ast.h
	cp ast/ast.h $(includedir)/.
	cp ast/grf.h $(includedir)/.
	cp ast/grf3d.h $(includedir)/.

ast/.libs/libast_err.a :
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C ast -j $(JOBS) libast_err.la
	cp ast/.libs/libast_err.a $(libdir)/.

ast/.libs/libast_pal.a :
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C ast -j $(JOBS) libast_pal.la
	cp ast/.libs/libast_pal.a $(libdir)/.

ast/.libs/libast_cminpack.a :
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C ast -j $(JOBS) libast_cminpack.la
	cp ast/.libs/libast_cminpack.a $(libdir)/.

#-------------------------- funtools

funtools : funtools/libfuntools.a

# no parallel
funtools/libfuntools.a : funtools/Makefile
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C funtools lib
	cp funtools/funtools.h $(includedir)/.
	cp funtools/filter/*.h $(includedir)/.
	cp funtools/util/*.h $(includedir)/.
	cp funtools/fitsy/*.h $(includedir)/.
	cp funtools/libfuntools.a $(libdir)/.

funtools/Makefile : funtools/configure
	@echo ""
	@echo "*** $@ ***"
	cd funtools; \
	./configure \
	CFLAGS='-g -O2 -std=gnu90 -w' \
	--with-zlib=$(libdir)/libz.a \
	$(CONFIGFLAGS) $(TARGET) \
	$(PREFIX) \
	--disable-shared

funtools/configure :
	cd funtools; \
	./mkconfigure

