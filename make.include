#-------------------------- language

.PHONY	: language

language:
	cd ds9; \
	grep 'msgcat::mc' library/*.tcl | tclsh$(TCL_VERSION) util/mergedict.tcl da iso8859-1; \
	grep 'msgcat::mc' library/*.tcl | tclsh$(TCL_VERSION) util/mergedict.tcl de iso8859-1; \
	grep 'msgcat::mc' library/*.tcl | tclsh$(TCL_VERSION) util/mergedict.tcl es iso8859-1; \
	grep 'msgcat::mc' library/*.tcl | tclsh$(TCL_VERSION) util/mergedict.tcl fr iso8859-1; \
	grep 'msgcat::mc' library/*.tcl | tclsh$(TCL_VERSION) util/mergedict.tcl pt iso8859-1; \
	grep 'msgcat::mc' library/*.tcl | tclsh$(TCL_VERSION) util/mergedict.tcl cs iso8859-2; \
	grep 'msgcat::mc' library/*.tcl | tclsh$(TCL_VERSION) util/mergedict.tcl ja euc-jp; \
	grep 'msgcat::mc' library/*.tcl | tclsh$(TCL_VERSION) util/mergedict.tcl zh big5

#-------------------------- tidy

.PHONY	: tidy

tidy	:
	$(call Tidy,ds9/doc)
	$(call Tidy,ds9/doc/release)
	$(call Tidy,ds9/doc/ref)

#-------------------------- scrub

.PHONY	: scrub

scrub :
	find . -name "*[~#]" -exec rm {} \;
	find . -d -name "autom4te.cache" -exec $(RM) -fr {} \;

#-------------------------- clean

.PHONY	: clean
.PHONY	: dirsclean ds9clean ds9parsersclean localclean
.PHONY	: opensslclean
.PHONY	: tclxmlclean tclxmlrpcclean tlsclean
.PHONY	: tkbltclean tclfitsy tkconclean tkhtml1clean tkimgclean
.PHONY	: tkmpegclean tksvgclean tkagifclean
.PHONY	: tktableclean xpaclean zlibclean lz4clean bzip2clean
.PHONY	: vectorclean fitsyclean tclasdfclean libyamlclean astclean funtoolsclean
.PHONY	: tksaoclean

clean	: tclclean tkclean \
	opensslclean \
	tlsclean tclxmlclean tclxmlrpc xpaclean \
	tkbltclean tclfitsy tkconclean tktableclean tkimgclean \
	tkmpegclean tksvgclean tkagifclean tkhtml1clean \
	vectorclean fitsyclean astclean funtoolsclean ds9clean \
	tksaoclean osclean dirsclean localclean scrub

dirsclean :
	@echo ""
	@echo "*** $@ ***"
	for d in $(DIRS); do $(RM) -fr $$d; done

ds9clean :
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C ds9/$(OS) clean

ds9parsersclean :
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C ds9/$(OS) parsersclean

localclean :
	@echo ""
	@echo "*** $@ ***"
	$(RM) -f core *~ *#

opensslclean:
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C openssl clean

tclfitsyclean :
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C tclfitsy clean

tclxmlclean:
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C tclxml clean

tclxmlrpcclean:
