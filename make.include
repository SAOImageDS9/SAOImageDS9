#-------------------------- tls

# no cache (win)
tls	: tls/Makefile
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C tls install-binaries

tls/Makefile :
	@echo ""
	@echo "*** $@ ***"
	cd tls; \
	./configure \
	--with-openssl-dir=$(prefix)/openssl --enable-static-ssl \
	--with-openssl-libdir=$(prefix)/openssl  \
	 $(TLSFLAGS) \
	$(WITHTCL) \
	$(PREFIX) \
	$(STD)

#-------------------------- zlib

# zlib has its own hand-written configure (not autoconf) - it doesn't
# understand VAR=value positional args, so any cross-compile CC/AR
# override in $(CONFIGFLAGS) has to be a real shell-env prefix here,
# not a positional argument the way the autoconf-based packages take it.
# It also doesn't understand --exec-prefix or --config-cache, so this
# can't just reuse $(PREFIX)/$(CACHE) like the autoconf-based packages.
#
# The dependency below is deliberately zlib/configure.log, not
# zlib/Makefile: zlib's tarball ships a placeholder Makefile (just
# "Please use ./configure first") alongside Makefile.in, and its own
# distclean rule *recreates* that same placeholder - so keying off
# Makefile's existence means a reconfigure after distclean would never
# fire. configure.log is only ever written by ./configure itself and is
# genuinely removed (not recreated) by distclean, so it's a reliable
# sentinel for "configure has actually been run".

zlib	: zlib/configure.log
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C zlib -j $(JOBS) install

zlib/configure.log :
	@echo ""
	@echo "*** $@ ***"
	cd zlib; \
	$(CONFIGFLAGS) ./configure \
	--prefix=$(prefix) --libdir=$(libdir) --includedir=$(includedir) \
	--static

#-------------------------- lz4

# lz4 has no ./configure step at all - a plain hand-written Makefile, not
# autoconf, and not even zlib's own hand-written-but-configure-shaped
# script. Build and install straight from the top, with BUILD_SHARED=no
# for static-only (its own spelling of that switch) and $(CONFIGFLAGS) as
# ordinary `make` variable overrides - unlike zlib's script, a plain
# Makefile understands CC=/AR= given this way natively, no env-prefix
# trick required. No configure step also means no placeholder-Makefile
# trap like zlib's and no separate "has it been configured yet" gate is
# needed - lz4/lib's own Makefile already tracks object-file staleness,
# same as every other already-built package's repeated `install` calls.
#
# Currently vendored for Phase 2's future ASDF container reader in
# tksao (real Roman ASDF files use lz4-compressed blocks - see TODO.md
# Phase 1), not because anything in the build consumes it yet - unlike
# zlib (funtools/gcat) and libyaml (ast), lz4 has no consumer in this
# tree today.

lz4	:
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C lz4/lib -j $(JOBS) install \
	$(CONFIGFLAGS) \
	BUILD_SHARED=no BUILD_STATIC=yes \
	PREFIX=$(prefix) LIBDIR=$(libdir) INCLUDEDIR=$(includedir)

#-------------------------- bzip2

# bzip2, like lz4, has no ./configure at all - a plain hand-written
# Makefile, so $(CONFIGFLAGS) works as ordinary `make` variable overrides
# and no "has it been configured yet" gate is needed.
#
# Three things about that Makefile mean this can't just be `make install`
# the way lz4 is:
#
#   1. Its `all` target is `libbz2.a bzip2 bzip2recover test` - it builds
#      the command-line tools and *runs the compression test suite*. Its
#      `install` depends on the tools, then copies them and their man
#      pages into $(PREFIX)/bin and $(PREFIX)/man. None of that is wanted
#      here: the only consumer is tclasdf, which needs libbz2.a and
#      bzlib.h and nothing else. So build the `libbz2.a` target by name
#      and place the two files directly.
#   2. `install` understands only PREFIX, with lib/, include/ and man/
#      hard-coded beneath it - there is no LIBDIR/INCLUDEDIR the way lz4's
#      Makefile has, so it could not be pointed at $(libdir)/$(includedir)
#      even if the tools were wanted.
#   3. Its `distclean` does `rm -f manual.ps manual.html manual.pdf`, and
#      all three of those are *tracked upstream files* shipped in the
#      tarball - so `make -C bzip2 distclean` would delete vendored
#      source. bzip2distclean below therefore runs `clean`, not
#      `distclean` (same as lz4distclean already does).
#
# RANLIB: bzip2 builds libbz2.a with `ar cq`, which does not write a
# symbol index, and then runs $(RANLIB) to add one. The tree's shared
# $(CONFIGFLAGS) sets only CC and AR, so a cross build would index a
# mingw archive with the host ranlib; $(TARGET) is set only by
# win/Makefile.in, so name the matching ranlib there and nowhere else.
#
# Vendored for ASDF's bzp2 block compression (see TODO.md Phase 5 and
# Tests/asdf/fixtures/bzp2/). Like lz4, nothing else in this tree
# consumes it.

bzip2	:
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C bzip2 -j $(JOBS) libbz2.a \
	$(CONFIGFLAGS) $(if $(TARGET),RANLIB=$(TARGET)-ranlib,)
	cp -p bzip2/libbz2.a $(libdir)/.
	cp -p bzip2/bzlib.h $(includedir)/.

