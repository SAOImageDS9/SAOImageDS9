}

proc region::YYABORT {} {
    return -code return 1
}

proc region::YYACCEPT {} {
    return -code return 0
}

proc region::YYERROR {} {
    variable yyerr
    set yyerr 1
}

proc region::yyclearin {} {
    variable token
    variable yycnt
    set token {}
    incr yycnt -1
}

proc region::yyerror {s} {
