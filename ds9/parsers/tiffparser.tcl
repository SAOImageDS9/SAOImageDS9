proc tiff::yyclearin {} {
    variable token
    variable yycnt
    set token {}
    incr yycnt -1
}

proc tiff::yyerror {s} {
    puts stderr $s
}

proc tiff::setupvalues {stack pointer numsyms} {
    upvar 1 1 y
    set y {}
    for {set i 1} {$i <= $numsyms} {incr i} {
        upvar 1 $i y
        set y [lindex $stack $pointer]
        incr pointer
    }
}

proc tiff::unsetupvalues {numsyms} {
    for {set i 1} {$i <= $numsyms} {incr i} {
        upvar 1 $i y
        unset y
    }
}

