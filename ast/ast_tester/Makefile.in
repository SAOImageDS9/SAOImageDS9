all: all-am

.SUFFIXES:
.SUFFIXES: .c .f .lo .log .o .obj .tap .tap$(EXEEXT) .trs
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign ast_tester/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign ast_tester/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-checkPROGRAMS:
	@list='$(check_PROGRAMS)'; test -n "$$list" || exit 0; \
	echo " rm -f" $$list; \
	rm -f $$list || exit $$?; \
	test -n "$(EXEEXT)" || exit 0; \
	list=`for p in $$list; do echo "$$p"; done | sed 's/$(EXEEXT)$$//'`; \
	echo " rm -f" $$list; \
	rm -f $$list

clean-noinstLTLIBRARIES:
	-test -z "$(noinst_LTLIBRARIES)" || rm -f $(noinst_LTLIBRARIES)
	@list='$(noinst_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}
star_compat/$(am__dirstamp):
	@$(MKDIR_P) star_compat
	@: > star_compat/$(am__dirstamp)
star_compat/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) star_compat/$(DEPDIR)
	@: > star_compat/$(DEPDIR)/$(am__dirstamp)
star_compat/libstar_compat_la-err_standalone.lo:  \
	star_compat/$(am__dirstamp) \
	star_compat/$(DEPDIR)/$(am__dirstamp)
star_compat/libstar_compat_la-psx_standalone.lo:  \
	star_compat/$(am__dirstamp) \
	star_compat/$(DEPDIR)/$(am__dirstamp)
star_compat/libstar_compat_la-chr_standalone.lo:  \
	star_compat/$(am__dirstamp) \
	star_compat/$(DEPDIR)/$(am__dirstamp)
star_compat/libstar_compat_la-cnf_standalone.lo:  \
	star_compat/$(am__dirstamp) \
	star_compat/$(DEPDIR)/$(am__dirstamp)
star_compat/libstar_compat_la-num_standalone.lo:  \
	star_compat/$(am__dirstamp) \
	star_compat/$(DEPDIR)/$(am__dirstamp)

libstar_compat.la: $(libstar_compat_la_OBJECTS) $(libstar_compat_la_DEPENDENCIES) $(EXTRA_libstar_compat_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libstar_compat_la_LINK) $(am_libstar_compat_la_rpath) $(libstar_compat_la_OBJECTS) $(libstar_compat_la_LIBADD) $(LIBS)

ast_astequal$(EXEEXT): $(ast_astequal_OBJECTS) $(ast_astequal_DEPENDENCIES) $(EXTRA_ast_astequal_DEPENDENCIES) 
	@rm -f ast_astequal$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(ast_astequal_OBJECTS) $(ast_astequal_LDADD) $(LIBS)

