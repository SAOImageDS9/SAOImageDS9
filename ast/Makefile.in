mostlyclean-libtool:
	-rm -f *.lo

clean-libtool:
	-rm -rf .libs _libs
	-rm -rf cminpack/.libs cminpack/_libs
	-rm -rf src/.libs src/_libs
	-rm -rf wcslib/.libs wcslib/_libs

distclean-libtool:
	-rm -f libtool config.lt
install-dist_pkgdataDATA: $(dist_pkgdata_DATA)
	@$(NORMAL_INSTALL)
	@list='$(dist_pkgdata_DATA)'; test -n "$(pkgdatadir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(pkgdatadir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(pkgdatadir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(pkgdatadir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(pkgdatadir)" || exit $$?; \
	done

uninstall-dist_pkgdataDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(dist_pkgdata_DATA)'; test -n "$(pkgdatadir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(pkgdatadir)'; $(am__uninstall_files_from_dir)
install-dist_starnewsDATA: $(dist_starnews_DATA)
	@$(NORMAL_INSTALL)
	@list='$(dist_starnews_DATA)'; test -n "$(starnewsdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(starnewsdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(starnewsdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(starnewsdir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(starnewsdir)" || exit $$?; \
	done

uninstall-dist_starnewsDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(dist_starnews_DATA)'; test -n "$(starnewsdir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(starnewsdir)'; $(am__uninstall_files_from_dir)
install-stardocsDATA: $(stardocs_DATA)
	@$(NORMAL_INSTALL)
	@list='$(stardocs_DATA)'; test -n "$(stardocsdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(stardocsdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(stardocsdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(stardocsdir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(stardocsdir)" || exit $$?; \
	done

uninstall-stardocsDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(stardocs_DATA)'; test -n "$(stardocsdir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(stardocsdir)'; $(am__uninstall_files_from_dir)
install-cincludeHEADERS: $(cinclude_HEADERS)
	@$(NORMAL_INSTALL)
	@list='$(cinclude_HEADERS)'; test -n "$(cincludedir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(cincludedir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(cincludedir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_HEADER) $$files '$(DESTDIR)$(cincludedir)'"; \
	  $(INSTALL_HEADER) $$files "$(DESTDIR)$(cincludedir)" || exit $$?; \
	done

uninstall-cincludeHEADERS:
	@$(NORMAL_UNINSTALL)
	@list='$(cinclude_HEADERS)'; test -n "$(cincludedir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(cincludedir)'; $(am__uninstall_files_from_dir)
