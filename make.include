# tcl 9.0.3
# tk 9.0.3
# tcllib 1.20
# tklib .7

# tksvg 0.7.2
# awthemes 10.3.0
# ttkthemes 3.2.2
# scidthemes 0.9.3

# fickle 2.2
# taccle 1.4
# tclfitsy 1.0
# tclsignal 1.5.0
# tclxml 3.2
# tclxmlrpc 1.0
# tclzipfs 1.0.1
# tls 2.0
# tkagif 1.1
# tkblt 3.3
# tkcon 2.8
# tkhtml1 1.1
# tkimg 2.0.1
# tkmpeg 1.1
# tktable 2.13

# ast 9.2.14
# funtools 1.5.0
# zlib 1.2.8
# xpa 2.2.1
# libxslt 1.1.29
# openssl 1.0.2u

DS9_VERSION	= 8.8b2
XPA_VERSION	= 2.2.1
TCL_VERSION	= 9.0
TCL_MAJOR_VERSION = $(firstword $(subst ., ,$(TCL_VERSION)))

Tidy = \
	cd $(1); \
	for ff in *.html; \
	do echo ""; echo $$ff; \
	tidy -q -m -w 0 $$ff; \
	done;

TidyFile = \
	cd $(1); \
	echo ""; echo $(2); \
	tidy -q -m -w 0 $(2);

#-------------------------- Defs

DIRS   = $(bindir) $(libdir) $(includedir) $(datadir) man build dist
PREFIX = --prefix $(prefix) --exec-prefix $(exec_prefix) --libdir $(libdir)
STD    = --disable-shared --disable-stubs --enable-symbols
STDSTUBS = --disable-shared --enable-stubs --enable-symbols

#-------------------------- funtools tmp files

FUNTOOLSTMPFILES = \
		 funtools/conf.h \
		 funtools/faq/Makefile \
		 funtools/filter/Makefile \
		 funtools/filter/config.status \
		 funtools/fitsy/Makefile \
		 funtools/fitsy/config.status \
		 funtools/funtest/Makefile \
		 funtools/funtest/conf.h \
		 funtools/gnu/Makefile \
		 funtools/gnu/conf.h \
		 funtools/util/Makefile \
		 funtools/util/conf.h \
		 funtools/util/config.status \
		 funtools/wcs/Makefile \
		 funtools/wcs/config.status

#-------------------------- tkimg tmp files

TKIMGTMPFILES = \
	      tkimg/libjpeg/libjpeg \
	      tkimg/libtiff/build \
	      tkimg/libtiff/contrib \
	      tkimg/libtiff/html \
	      tkimg/libtiff/libtiff \
	      tkimg/libtiff/libtool \
	      tkimg/libtiff/man \
	      tkimg/libtiff/mkg3states \
	      tkimg/libtiff/mkg3states.dSYM \
	      tkimg/libtiff/port \
	      tkimg/libtiff/test \
	      tkimg/libtiff/tif_fax3sm.c \
	      tkimg/libtiff/tools \
	      tkimg/base/tkimgUuid.h \
	      tkimg/compat/libtiff/doc/__pycache__/ \
	      tkimg/libtiff/config/ \
	      tkimg/libtiff/doc/ \
	      tkimg/libtiff/libtiff-4.pc

#-------------------------- main

.NOTPARALLEL :
.PHONY	: all dirs ds9 tclxml tclxmlrpc tclzipfs tls xpa zlib lz4 bzip2
.PHONY	: tkblt tclfitsy tkcon tkhtml1 tkimg tkmpeg tksvg tkagif tksao tktable
.PHONY	: vector fitsy tclasdf libyaml ast funtools openssl

all	: saods9

dirs	:
	@echo ""
	@echo "*** Cores $(JOBS) ***"
	@echo ""
	@echo "*** Install $@ ***"
	@for d in $(DIRS); do if [ ! -d $$d ]; then mkdir $$d; fi done

#-------------------------- ds9

ds9	: ds9/$(OS)/Makefile
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C ds9/$(OS) -j $(JOBS)

debug	: ds9/$(OS)/Makefile
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C ds9/$(OS)  -j $(JOBS) debug

ds9/$(OS)/Makefile :
	@echo ""
	@echo "*** $@ ***"
	cd ds9/$(OS); \
	./configure \
	$(WITHTK) \
  	--with-xml2-config=$(XML2CONFIG) \
	$(PREFIX) \
	$(STD) \
	$(CACHE)

#--------------------------openssl

openssl	: openssl/Makefile
	@echo ""
	@echo "*** $@ ***"
	$(MAKE) -C openssl -j $(JOBS)

openssl/Makefile:
	@echo ""
	@echo "*** $@ ***"
	cd openssl; \
	$(SSLCONFIG) --prefix=$(prefix) --openssldir=$(prefix) no-shared

