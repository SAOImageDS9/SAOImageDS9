xpa/Makefile :
	@echo ""
	@echo "*** $@ ***"
	cd xpa; \
	./configure \
	$(CONFIGFLAGS) $(TARGET) $(XPAFLAGS) \
	$(WITHTCL) \
	$(PREFIX) \
	$(STD) \
	--with-x=no

