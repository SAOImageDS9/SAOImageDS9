# TktableConfig.sh --
#
# This shell script (for sh) is generated automatically by TkTable's
# configure script.  It will create shell variables for some of the
# configuration options discovered by the configure script. This
# script is intended to be included by the configure scripts for
# TkTable extensions so that they don't have to figure this all
# out for themselves.  This file does not duplicate information
# already provided by tclConfig.sh and tkConfig.sh, so you may need
# to use them in addition to this one.
#
# The information in this file is specific to a single platform.
#

#
# Tktable version number.
#
Tktable_VERSION='@PACKAGE_VERSION@'

# The name of the Tktable library (may be either a .a file or a shared library):
Tktable_LIB_FILE=@PKG_LIB_FILE@

#
# String to pass to linker to pick up the Tktable library from its
# build directory.
#
Tktable_BUILD_LIB_SPEC='@Tktable_BUILD_LIB_SPEC@'

#
# String to pass to linker to pick up the Tktable library from its
# installed directory.
#
Tktable_LIB_SPEC='@Tktable_LIB_SPEC@'

# Use the following with TEA_ADD_STUB_SOURCES

#
# The name of the Tktable stub library (a .a file):
#
#Tktable_STUB_LIB_FILE=@PKG_STUB_LIB_FILE@

#
# String to pass to linker to pick up the Tktable stub library from its
# build directory.
#
#Tktable_BUILD_STUB_LIB_SPEC='@Tktable_BUILD_STUB_LIB_SPEC@'

#
# String to pass to linker to pick up the Tktable stub library from its
# installed directory.
#
#Tktable_STUB_LIB_SPEC='@Tktable_STUB_LIB_SPEC@'

#
# String to pass to linker to pick up the Tktable stub library from its
# build directory.
#
#Tktable_BUILD_STUB_LIB_PATH='@Tktable_BUILD_STUB_LIB_PATH@'

#
# String to pass to linker to pick up the Tktable stub library from its
# installed directory.
#
#Tktable_STUB_LIB_PATH='@Tktable_STUB_LIB_PATH@'


#
# Location of the top-level source directories from which Tktable
# was built.  This is the directory that contains generic, unix,
# win etc. If Tktable was compiled in a different place than the 
# directory containing the source files, this points to the 
# location of the sources, not the location where Tktable was compiled.
#
Tktable_SRC_DIR='@srcdir@'

# EOF
