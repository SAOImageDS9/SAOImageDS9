proc bookmark::yyclearin {} {
    variable token
    variable yycnt
    set token {}
    incr yycnt -1
}

proc bookmark::yyerror {s} {
    puts stderr $s
}

proc bookmark::setupvalues {stack pointer numsyms} {
    upvar 1 1 y
    set y {}
    for {set i 1} {$i <= $numsyms} {incr i} {
        upvar 1 $i y
        set y [lindex $stack $pointer]
        incr pointer
    }
}

proc bookmark::unsetupvalues {numsyms} {
    for {set i 1} {$i <= $numsyms} {incr i} {
        upvar 1 $i y
        unset y
    }
}

