                      CF8 = 3.3968643460408978e-06 	# Coeff 8 of forward polynomial 1
                      CF9 = 2.337289924862379e-06 	# Coeff 9 of forward polynomial 1
                      CF10 = -1.7176521130732983e-06 	# Coeff 10 of forward polynomial 1
                      CF11 = -7.5995376252821781e-07 	# Coeff 11 of forward polynomial 1
                      CF12 = 5.9600914613943012e-07 	# Coeff 12 of forward polynomial 1
                      CF13 = -6.4252616859955014e-08 	# Coeff 13 of forward polynomial 1
