# tclasdfConfig.sh --
#
# This shell script (for sh) is generated automatically by tclasdf's
# configure script.  It will create shell variables for most of
# the configuration options discovered by the configure script.
# This script is intended to be included by the configure scripts
# for tclasdf extensions so that they don't have to figure this all
# out for themselves.  This file does not duplicate information
# already provided by tclConfig.sh, so you may need to use that
# file in addition to this one.
#
# The information in this file is specific to a single platform.

# tclasdf's version number.
tclasdf_VERSION='@PACKAGE_VERSION@'

# The name of the tclasdf library (may be either a .a file or a shared library):
tclasdf_LIB_FILE=@PKG_LIB_FILE@

# String to pass to linker to pick up the tclasdf library from its
# build directory.
tclasdf_BUILD_LIB_SPEC='@tclasdf_BUILD_LIB_SPEC@'

# String to pass to linker to pick up the tclasdf library from its
# installed directory.
tclasdf_LIB_SPEC='@tclasdf_LIB_SPEC@'

# The name of the tclasdf stub library (a .a file):
#tclasdf_STUB_LIB_FILE=@PKG_STUB_LIB_FILE@

# String to pass to linker to pick up the tclasdf stub library from its
# build directory.
#tclasdf_BUILD_STUB_LIB_SPEC='@tclasdf_BUILD_STUB_LIB_SPEC@'

# String to pass to linker to pick up the tclasdf stub library from its
# installed directory.
#tclasdf_STUB_LIB_SPEC='@tclasdf_STUB_LIB_SPEC@'

# String to pass to linker to pick up the tclasdf stub library from its
# build directory.
#tclasdf_BUILD_STUB_LIB_PATH='@tclasdf_BUILD_STUB_LIB_PATH@'

# String to pass to linker to pick up the tclasdf stub library from its
# installed directory.
#tclasdf_STUB_LIB_PATH='@tclasdf_STUB_LIB_PATH@'
