#!/bin/sh
# TAP producer for Mapping-simplification regression tests.
#
# Runs simplify on each case listed in fixtures/simplify/cases.txt (the same
# manifest the CMake test suite reads) and checks its output two ways,
# matching the CMake suite:
#   - ast_astequal: a semantic (astEqual) comparison against the reference,
#     run for every case;
#   - compare_dumps against the reference, which passes a byte-equal line and
#     otherwise compares tokens, treating two doubles within 4 ULP as equal.
#     The fourth column of the manifest selects the tolerance: blank is 4 ULP,
#     "astequal" widens it to AST's own astEQUAL for a value amplified by
#     cancellation, and "yes" runs no dump comparison at all -- right for a
#     negative fixture, whose reference is the unsimplified input that
#     astSimplify's IsSimp stamp can never match by string.
#
# One TAP result is emitted per case; a case passes only if all its applicable
# checks pass.  simplify writes AST-Channel dumps, so ast_astequal reads them
# with the "ast" encoding.
srcdir=${srcdir:-.}
# Fixture paths in the manifest are relative to the fixture root.
fixtures=${srcdir}/fixtures
data=${fixtures}/simplify/cases.txt

# The cut-down distribution ships this manifest but not the fixtures it names,
# so report the family as skipped rather than failing every case.
if [ ! -f "$data" ] || ! ls "${fixtures}"/simplify/*.map >/dev/null 2>&1; then
    echo "1..0 # SKIP fixtures not distributed"
    exit 0
fi

trim() {
    printf '%s' "$1" | sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//'
}

# TAP plan: the number of data (non-blank, non-comment) lines.
echo "1..$(grep -cvE '^[[:blank:]]*(#|$)' "$data")"

idx=0
while IFS='|' read -r name input reference skip rest; do
    name=$(trim "$name")
    case $name in ''|'#'*) continue ;; esac
    input=$(trim "$input")
    reference=$(trim "$reference")
    skip=$(trim "$skip")

    idx=$((idx + 1))
    test="$idx - $name"
    out=${name}.out
    rm -f "$out"

    ./simplify "${fixtures}/${input}" "$out" > "${out}.log" 2>&1 < /dev/null
    if [ $? -ne 0 ]; then
        echo "not ok $test"
        sed 's/^/# /' "${out}.log"
        rm -f "$out" "${out}.log"
        continue
    fi

    ok=1
    # Dump comparison against the reference, at the tolerance the manifest asks
    # for.  An unrecognised flag is an error rather than a silent exact
    # comparison, matching the CMake suite.
    tol=
    case $skip in
        '')       ;;
        astequal) tol=--astequal ;;
        yes)      ;;
        *)  echo "Bail out! simplify/cases.txt: row $name has" \
                 "skip_string_compare \"$skip\"; expected blank, astequal or yes"
            exit 1 ;;
    esac
    if [ "$skip" != yes ]; then
        if ! ./compare_dumps $tol "${fixtures}/${reference}" "$out" \
                > "${out}.cmp" 2>&1; then
            ok=0
            echo "# $name: dump differs from reference"
            sed 's/^/# /' "${out}.cmp"
            diff -u "${fixtures}/${reference}" "$out" | sed 's/^/# /'
        fi
    fi
    # Semantic comparison (always).
    if ! ./ast_astequal "${fixtures}/${reference}" "$out" ast \
            > "${out}.eq" 2>&1 < /dev/null; then
        ok=0
        echo "# $name: ast_astequal reported not equal to reference"
        sed 's/^/# /' "${out}.eq"
    fi

    if [ "$ok" -eq 1 ]; then
        echo "ok $test"
    else
        echo "not ok $test"
    fi
    rm -f "$out" "${out}.log" "${out}.cmp" "${out}.eq"
done < "$data"
